# .dockerignore — PREDICCIONESMX (multi-stage Python + Next.js)
# Cosas que NO se copian al contexto de docker build.

# Git
.git/
.gitignore
.github/

# Secretos (jamás a la imagen)
.secrets/
.env
.env.*
*.env.local
*.env.production
*.github_token
*.bak
*.broken

# Datos runtime (la BD se monta como bind-mount en runtime)
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm
data/**/*.sqlite
data/**/*.sqlite3
data/raw/
data/processed/
data/historical/
data/backups/
data/logs/
data/agent_reports/
data/*.log
data/calibration_dataset.csv
data/platt_coefficients.json*
data/backtest_*

# Modelos entrenados (binarios, se regeneran)
models/

# Node / Next.js (se re-instalan dentro del Dockerfile)
node_modules/
.next/
.next-cache/
out/
build/
dist/
*.tsbuildinfo
.next-env.d.ts
.npm/
.pnpm-store/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Tareas del sistema (no parte del proyecto)
tareas/

# Tests no necesarios en runtime (se corren en CI)
tests/

# Archivos de deploy (se montan aparte)
deploy/
dokploy*.yml
docker-compose*.yml
DEPLOY_STATUS.md

# Docs no runtime
docs/
ARCHITECTURE.md
README.md
cinepolis_preview.html

# Backups de config
*.bak
*.broken
