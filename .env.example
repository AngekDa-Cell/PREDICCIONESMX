# =============================================================
# Predictions_MX — Variables de entorno (PLANTILLA)
# =============================================================
# Copia este archivo a `.env` y rellena los valores reales.
# El archivo `.env` NUNCA debe commitearse al repo.

# Token de SportMonks (suscripción de Ángel Padilla)
SPORTMONKS_API_TOKEN=

# Base URL de la API v3
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

# IDs de ligas (ofrecidos por Ángel en junio 2026)
SPORTMONKS_LEAGUE_MEXICO_PARENT=458
SPORTMONKS_LEAGUE_LIGA_MX=743
SPORTMONKS_LEAGUE_LIGA_EXPANSION=749

# Límite del plan (ajustar según plan contratado)
# Starter: 2000/h, Growth: 2500/h, Pro: 3000/h, Enterprise: 5000/h
# Plan custom de Ángel Padilla (jun 2026): 3000/h
SPORTMONKS_RATE_LIMIT_PER_HOUR=3000

# Path de la base de datos SQLite
DATABASE_URL=sqlite:////workspace/proyectos/data/predictions_mx.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=/workspace/proyectos/data/predictions_mx.log

# Zona horaria (Ángel está en Colima, GMT-6)
TZ=America/Mexico_City

# --- Telegram (para reportes automáticos desde backup_db.sh / recalibrate_platt.sh) ---
# En Dokploy: inyectar como Dokploy secret.
# Local dev: fallback al CONFIG_FILE del agente (openclaw.json) si está vacío.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=8683821860

# Path absoluto de la BD (debe coincidir con el bind-mount en Dokploy).
# Docker: /workspace/proyectos/data/predictions_mx.db (bind-mount: /srv/predicciones-mx/data)
# (Ver DATABASE_URL arriba — este bloque es solo documentación del path esperado.)